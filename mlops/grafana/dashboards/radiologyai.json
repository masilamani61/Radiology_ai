{
  "title": "RadiologyAI Monitor",
  "panels": [
    {
      "title": "Request Rate",
      "type": "graph",
      "gridPos": {"x":0,"y":0,"w":12,"h":8},
      "targets": [{"expr": "rate(http_requests_total[1m])", "legendFormat": "req/sec"}]
    },
    {
      "title": "Inference Latency P95",
      "type": "graph",
      "gridPos": {"x":12,"y":0,"w":12,"h":8},
      "targets": [{"expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))", "legendFormat": "p95 latency"}]
    },
    {
      "title": "Error Rate",
      "type": "graph",
      "gridPos": {"x":0,"y":8,"w":12,"h":8},
      "targets": [{"expr": "rate(http_requests_total{status=~\"5..\"}[5m])", "legendFormat": "error rate"}]
    },
    {
      "title": "Total Predictions",
      "type": "stat",
      "gridPos": {"x":12,"y":8,"w":12,"h":8},
      "targets": [{"expr": "http_requests_total{handler=\"/api/v1/predict\"}", "legendFormat": "predictions"}]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 16
}
